<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_contract_tree" model="ir.ui.view">
            <field name="name">customer.document.contract.tree</field>
            <field name="model">customer.document.contract</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="contract_type"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="value"/>
                    <field name="file"/>
                    <field name="state"/>
                    <field name="customer_id"/>
                </tree>
            </field>
        </record>

        <record id="view_contract_form" model="ir.ui.view">
            <field name="name">customer.document.contract.form</field>
            <field name="model">customer.document.contract</field>
            <field name="arch" type="xml">
                <form string="Hợp đồng">
                    <sheet>
                        <notebook>
                            <page string="Thông tin hợp đồng">
                                <group>
                                    <group>
                                        <field name="code" readonly="1"/>
                                        <field name="name"/>
                                        <field name="contract_type"/>
                                        <field name="value"/>
                                    </group>
                                    <group>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="state"/>
                                        <field name="file"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="customer_id"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
