<odoo>
    <record id="action_customer_document_suggestion_wizard" model="ir.actions.act_window">
        <field name="name">Gợi ý văn bản AI</field>
        <field name="res_model">customer.document.suggestion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_customer_id': active_id}</field>
    </record>
    <record id="view_customer_document_suggestion_wizard_form" model="ir.ui.view">
        <field name="name">customer.document.suggestion.wizard.form</field>
        <field name="model">customer.document.suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="Gợi ý văn bản AI">
                <group>
                    <field name="customer_id" readonly="1"/>
                    <field name="top_k"/>
                </group>
                <footer>
                    <button name="action_suggest" type="object" string="Gợi ý" class="oe_highlight"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
                <field name="suggestion_ids">
                    <tree>
                        <field name="text"/>
                        <field name="score"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>
</odoo>
