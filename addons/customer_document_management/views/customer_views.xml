<odoo>
    <record id="view_customer_tree" model="ir.ui.view">
        <field name="name">customer.document.customer.tree</field>
        <field name="model">customer.document.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="group"/>
                <field name="province"/>
                <field name="district"/>
                <field name="ward"/>
                <field name="address"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">customer.document.customer.form</field>
        <field name="model">customer.document.customer</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_customer_document_suggestion_wizard)d" type="action" class="oe_stat_button" icon="fa-lightbulb-o" string="Gợi ý văn bản AI"/>
                    </div>
                    <notebook>
                        <page string="Thông tin khách hàng">
                            <group>
                                <group>
                                    <field name="code" readonly="1"/>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="state"/>
                                </group>
                                <group>
                                    <field name="email"/>
                                    <field name="group"/>
                                    <field name="province"/>
                                    <field name="district"/>
                                    <field name="ward"/>
                                    <field name="address"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Thông tin hợp đồng">
                            <field name="document_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="issue_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_customer_document_suggestion_wizard)d" type="action" class="oe_stat_button" icon="fa-lightbulb-o" string="Gợi ý văn bản AI"/>
                        </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>