<odoo>
    <record id="view_customer_tree" model="ir.ui.view">
        <field name="name">customer.document.customer.tree</field>
        <field name="model">customer.document.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="address"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">customer.document.customer.form</field>
        <field name="model">customer.document.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                    </group>
                    <group string="Văn bản số hóa">
                        <field name="document_ids">
                            <tree>
                                <field name="name"/>
                                <field name="document_type"/>
                                <field name="issue_date"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>