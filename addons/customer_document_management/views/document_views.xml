<odoo>
    <record id="view_document_search" model="ir.ui.view">
        <field name="name">customer.document.document.search</field>
        <field name="model">customer.document.document</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm văn bản">
                <field name="code" string="Mã văn bản" filter_domain="[('code','ilike',self)]"/>
                <field name="name" string="Tên văn bản" filter_domain="[('name','ilike',self)]"/>
                <field name="customer_id" string="Khách hàng"/>
                <field name="description" string="Mô tả" filter_domain="[('description','ilike',self)]"/>
                <filter string="Hiệu lực" name="state_active" domain="[('state','=','active')]"/>
                <filter string="Hết hiệu lực" name="state_expired" domain="[('state','=','expired')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khách hàng" name="group_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Ngày phát hành" name="group_issue_date" context="{'group_by':'issue_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">customer.document.document.tree</field>
        <field name="model">customer.document.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="issue_date"/>
                <field name="end_date"/>
                <field name="cost"/>
                <field name="state"/>
                <field name="customer_id"/>
            </tree>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">customer.document.document.form</field>
        <field name="model">customer.document.document</field>
        <field name="arch" type="xml">
            <form string="Văn bản số hóa">
                <sheet>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="issue_date"/>
                            <field name="end_date"/>
                            <field name="cost"/>
                            <field name="state"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="file_ids">
                                <tree editable="bottom">
                                    <field name="name" invisible="1"/>
                                    <field name="document_type"/>
                                    <field name="document_type_manual" attrs="{'invisible': [('document_type', '!=', 'other')], 'required': [('document_type', '=', 'other')]}"/>
                                    <field name="file" filename="name"/>
                                    <field name="upload_user_id"/>
                                    <field name="upload_date"/>
                                    <button name="action_suggest_label" type="object" icon="fa-lightbulb-o" attrs="{'invisible': [('id', '=', False)]}" string="AI gợi ý" class="btn-info"/>
                                    <button name="action_view_file" type="object" icon="fa-eye" attrs="{'invisible': [('id', '=', False)]}" string="Xem"/>
                                    <button name="download_file_action" type="object" icon="fa-download" attrs="{'invisible': [('id', '=', False)]}" string="Tải"/>
                                </tree>
                                <form string="Tệp đính kèm">
                                    <group>
                                        <field name="name" invisible="1"/>
                                        <field name="document_type"/>
                                        <field name="document_type_manual" attrs="{'invisible': [('document_type', '!=', 'other')], 'required': [('document_type', '=', 'other')]}"/>
                                        <field name="file" filename="name"/>
                                        <field name="upload_user_id"/>
                                        <field name="upload_date"/>
                                        <field name="document_id"/>
                                    </group>
                                    <group>
                                        <button name="action_suggest_label" type="object" string="AI gợi ý loại văn bản" class="btn-info"/>
                                    </group>
                                    <footer>
                                        <button name="action_view_file" type="object" string="Xem trực tiếp" class="btn-secondary"/>
                                        <button name="download_file_action" type="object" string="Tải file về" class="btn-primary"/>
                                    </footer>
                                </form>
                            </field>
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>