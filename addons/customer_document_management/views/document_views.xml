<odoo>
    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">customer.document.document.tree</field>
        <field name="model">customer.document.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="issue_date"/>
                <field name="end_date"/>
                <field name="cost"/>
                <field name="state"/>
                <field name="customer_id"/>
            </tree>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">customer.document.document.form</field>
        <field name="model">customer.document.document</field>
        <field name="arch" type="xml">
            <form string="Văn bản số hóa">
                <sheet>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="issue_date"/>
                            <field name="end_date"/>
                            <field name="cost"/>
                            <field name="state"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="file_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="file"/>
                                    <field name="upload_user_id"/>
                                    <field name="upload_date"/>
                                    <button name="action_view_file" type="object" icon="fa-eye" attrs="{'invisible': [('id', '=', False)]}" string=""/>
                                    <button name="download_file_action" type="object" icon="fa-download" attrs="{'invisible': [('id', '=', False)]}" string=""/>
                                </tree>
                                <form string="Tệp đính kèm">
                                    <group>
                                        <field name="name"/>
                                        <field name="document_type"/>
                                        <field name="file"/>
                                        <field name="upload_user_id"/>
                                        <field name="upload_date"/>
                                        <field name="document_id"/>
                                        <field name="suggested_document_type" readonly="1"/>
                                    </group>
                                    <footer>
                                        <button name="action_suggest_label" type="object" string="Gợi ý nhãn AI" class="btn-info"/>
                                        <button name="action_view_file" type="object" string="Xem trực tiếp" class="btn-secondary"/>
                                        <button name="download_file_action" type="object" string="Tải file về" class="btn-primary"/>
                                    </footer>
                                </form>
                            </field>
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_suggest_label" type="object" string="Gợi ý nhãn AI" class="btn-info"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>