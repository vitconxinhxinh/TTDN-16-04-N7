<odoo>
    <record id="view_ai_suggestion_wizard_form" model="ir.ui.view">
        <field name="name">ai.suggestion.wizard.form</field>
        <field name="model">ai.suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="Gợi ý từ AI">
                <group>
                    <field name="file_id" invisible="1"/>
                    <field name="suggested_type"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Xác nhận" class="btn-primary"/>
                    <button special="cancel" string="Hủy" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
