<odoo>
    <record id="view_document_file_search" model="ir.ui.view">
        <field name="name">customer.document.file.search</field>
        <field name="model">customer.document.file</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm file">
                <field name="name" string="Tên file" filter_domain="[('name','ilike',self)]"/>
                <field name="document_id" string="Văn bản"/>
                <field name="document_type" string="Loại văn bản"/>
                <field name="document_type_manual" string="Loại văn bản (Tùy chỉnh)" filter_domain="[('document_type_manual','ilike',self)]"/>
                <field name="upload_user_id" string="Người upload"/>
                <filter string="Hợp đồng lao động" name="type_labor" domain="[('document_type','=','labor_contract')]"/>
                <filter string="Hợp đồng mua bán" name="type_sales" domain="[('document_type','=','sales_contract')]"/>
                <filter string="Hợp đồng dịch vụ" name="type_service" domain="[('document_type','=','service_contract')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Loại văn bản" name="group_type" context="{'group_by':'document_type'}"/>
                    <filter string="Người upload" name="group_user" context="{'group_by':'upload_user_id'}"/>
                    <filter string="Ngày upload" name="group_date" context="{'group_by':'upload_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_document_file_tree" model="ir.ui.view">
        <field name="name">customer.document.file.tree</field>
        <field name="model">customer.document.file</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="document_type"/>
                <field name="document_type_manual"/>
                <field name="upload_user_id"/>
                <field name="upload_date"/>
                <button name="action_suggest_label" type="object" icon="fa-lightbulb-o" string="AI gợi ý loại văn bản" class="btn-info"/>
                <button name="action_view_file" type="object" icon="fa-eye" string="Xem trực tiếp"/>
                <button name="download_file_action" type="object" icon="fa-download" string="Tải về"/>
            </tree>
        </field>
    </record>
    <record id="view_document_file_form" model="ir.ui.view">
        <field name="name">customer.document.file.form</field>
        <field name="model">customer.document.file</field>
        <field name="arch" type="xml">
            <form string="Tệp đính kèm">
                <sheet>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="document_type"/>
                        <field name="document_type_manual" attrs="{'invisible': [('document_type', '!=', 'other')], 'required': [('document_type', '=', 'other')]}"/>
                        <field name="file" filename="name"/>
                        <field name="upload_user_id"/>
                        <field name="upload_date"/>
                        <field name="document_id"/>
                    </group>
                    <group>
                        <button name="action_suggest_label" type="object" string="AI gợi ý loại văn bản" class="btn-info"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_view_file" type="object" string="Xem trực tiếp" class="btn-secondary"/>
                    <button name="download_file_action" type="object" string="Tải file về" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
