<odoo>
    <record id="view_position_tree" model="ir.ui.view">
        <field name="name">nhan_su.position.tree</field>
        <field name="model">nhan_su.position</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>
    <record id="view_position_form" model="ir.ui.view">
        <field name="name">nhan_su.position.form</field>
        <field name="model">nhan_su.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                    <field name="employee_ids">
                        <tree>
                            <field name="name"/>
                            <field name="code"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
