<odoo>
    <record id="view_discipline_tree" model="ir.ui.view">
        <field name="name">nhan_su.discipline.tree</field>
        <field name="model">nhan_su.discipline</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="reason"/>
                <field name="amount"/>
                <field name="note"/>
            </tree>
        </field>
    </record>
    <record id="view_discipline_form" model="ir.ui.view">
        <field name="name">nhan_su.discipline.form</field>
        <field name="model">nhan_su.discipline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="reason"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
