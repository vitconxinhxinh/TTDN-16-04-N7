<odoo>
    <record id="view_salary_tree" model="ir.ui.view">
        <field name="name">nhan_su.salary.tree</field>
        <field name="model">nhan_su.salary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="base_salary"/>
                <field name="so_cong"/>
                <field name="late_days"/>
                <field name="overtime_hours"/>
                <field name="bonus"/>
                <field name="penalty"/>
                <field name="leave_days"/>
                <field name="luong_nhan"/>
                <field name="amount"/>
                <field name="note"/>
            </tree>
        </field>
    </record>
    <record id="view_salary_form" model="ir.ui.view">
        <field name="name">nhan_su.salary.form</field>
        <field name="model">nhan_su.salary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="employee_id"/>
                        <field name="month"/>
                        <field name="year"/>
                        <field name="date"/>
                        <field name="base_salary"/>
                        <field name="so_cong" readonly="1"/>
                        <field name="late_days"/>
                        <field name="overtime_hours"/>
                        <field name="bonus"/>
                        <field name="penalty"/>
                        <field name="leave_days"/>
                        <field name="luong_nhan" readonly="1"/>
                        <field name="amount" readonly="1"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
