<odoo>
    <record id="view_contract_tree" model="ir.ui.view">
        <field name="name">nhan_su.contract.tree</field>
        <field name="model">nhan_su.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="contract_type"/>
                <field name="salary"/>
            </tree>
        </field>
    </record>
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">nhan_su.contract.form</field>
        <field name="model">nhan_su.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="contract_type"/>
                        <field name="salary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
