<odoo>
    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">nhan_su.employee.tree</field>
        <field name="model">nhan_su.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="identifier"/>
                <field name="name"/>
                <field name="province"/>
                <field name="department_id"/>
                <field name="position_id"/>
                <!-- 'late' field and decoration removed: not present in model -->
            </tree>
        </field>
    </record>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">nhan_su.employee.form</field>
        <field name="model">nhan_su.employee</field>
        <field name="arch" type="xml">
            <form string="Thông tin nhân viên">
                <sheet>
                    <group col="4" string="Thông tin nhân viên">
                        <field name="identifier" readonly="1"/>
                        <field name="code" readonly="1"/>
                        <field name="name"/>
                        <field name="province"/>
                        <field name="department_id"/>
                        <field name="position_id"/>
                        <field name="base_salary"/>
                        <field name="allowance"/>
                    </group>
                    <notebook>
                        <page string="Hợp đồng">
                            <field name="contract_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bảng lương">
                            <field name="salary_ids">
                                <tree>
                                    <field name="month"/>
                                    <field name="year"/>
                                    <field name="base_salary"/>
                                    <field name="late_days"/>
                                    <field name="overtime_hours"/>
                                    <field name="bonus"/>
                                    <field name="penalty"/>
                                    <field name="leave_days"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nghỉ phép">
                            <field name="leave_ids">
                                <tree>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Kỷ luật">
                            <field name="discipline_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="reason"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Khen thưởng">
                            <field name="reward_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="reason"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
